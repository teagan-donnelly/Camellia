# =====================================================================
# Camellia — environment configuration (copy to backend/.env and fill in)
#   cp .env.example backend/.env
# backend/.env is git-ignored. NEVER commit real values.
# Format: KEY=value, one per line, no quotes, no spaces around "=".
# =====================================================================

# ---- Google Gemini (required for AI features) ----
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Current stable Flash model at time of writing; change if your key needs another model.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=60
# Used automatically when the primary model is overloaded (503) or rate limited (429) after retries.
# The UI always shows which model actually answered. Leave blank to disable.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# minimal | low | medium | high (blank = model default). Lower = faster answers.
GEMINI_THINKING_LEVEL=low

# ---- ElevenLabs (Camellia Briefing audio) ----
# Create a key in your ElevenLabs account settings. Put it in backend/.env.local (git-ignored), not the shared
# backend/.env, and never paste it into chat or commit it.
# Without it, briefings are transcript-only (labeled as such); no substitute voice is used.
ELEVENLABS_API_KEY=
# Optional: a specific voice. Unset = River (SAz9YHcvj6GT2YYXdXww, premade, conversational).
# Set it blank to use the first premade voice tagged "conversational" in your account.
# ELEVENLABS_VOICE_ID=
# eleven_multilingual_v2 (default) or eleven_v4; both accept 10,000 characters per request.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ---- Snowflake (primary database; key-pair authentication) ----
# Account identifier in <orgname>-<account_name> form (Snowsight: Admin > Accounts)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
# Absolute path to your PKCS#8 private key, OUTSIDE the repo.
# Use FORWARD slashes, even on Windows (backslashes are escape characters in this file):
#   Windows example: C:/Users/you/.snowflake/rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_FILE=
# Only if the private key is encrypted:
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_WAREHOUSE=CAMELLIA_WH
SNOWFLAKE_DATABASE=CAMELLIA_DEMO
SNOWFLAKE_SCHEMA=CLINICAL
SNOWFLAKE_ROLE=
# true = backend runs CREATE DATABASE/SCHEMA IF NOT EXISTS (needs privilege); false = they already exist
SNOWFLAKE_CREATE_DATABASE=true

# ---- Database mode ----
# auto      = Snowflake when SNOWFLAKE_ACCOUNT is set, otherwise the labeled LOCAL DEV FALLBACK (H2)
# snowflake = require Snowflake (fails fast with a diagnostic if config is incomplete)
# local     = local development fallback only (never presented as Snowflake)
CAMELLIA_DB_MODE=auto

# ---- Demo data ----
# Synthetic dates are relative to this anchor (blank = the day data is first seeded).
# Use "Reset demo data" in the System page to re-anchor to today.
CAMELLIA_DEMO_ANCHOR_DATE=

# ---- Cloud / serverless settings (see SERVERLESS_ARCHITECTURE.md). The defaults suit local development. ----
# Signs the simulated demo-session cookie. Blank = random per start, which is fine for one local backend but breaks
# sessions across several instances (Lambda), where it must come from Secrets Manager.
CAMELLIA_DEMO_SESSION_SECRET=
# Total Gemini time per request across retries and the fallback model (0 = no bound). Use 25 behind a 30 s gateway.
GEMINI_REQUEST_BUDGET_SECONDS=0
# "Reset demo data" and "Simulate lab result" in the UI. Set false for any public deployment.
CAMELLIA_DEMO_ADMIN_ENABLED=true
# Only for the camellia-jobs function: enables POST /events (seeding, screening, demo reset). Never on the public API.
CAMELLIA_JOBS_ENABLED=false
# In the cloud, secrets are NOT set here: the Lambda environment holds CAMELLIA_GEMINI_KEY_SECRET_ARN,
# CAMELLIA_SESSION_SECRET_ARN and CAMELLIA_SNOWFLAKE_KEY_SECRET_ARN, and the backend reads the values from
# AWS Secrets Manager at startup (AwsSecretsBootstrap). Those three are real environment variables, not .env keys.

# ---- Camellia V3 ----
# Non-public folder for generated briefing audio (served only through the authorized API). Default ./data/briefings
# CAMELLIA_BRIEFING_AUDIO_DIR=./data/briefings
# Non-public folder for uploaded patient documents (served only through the authorized API). Default ./data/documents
# CAMELLIA_DOCUMENTS_DIR=./data/documents
# Upload size limit in MB.
# CAMELLIA_DOCUMENTS_MAX_MB=10
# Monitoring display time zone (storage is UTC).
CAMELLIA_HOSPITAL_TIME_ZONE=America/New_York
# Show the clearly labeled wristband simulator controls to nursing roles.
CAMELLIA_SIMULATOR_ENABLED=true
