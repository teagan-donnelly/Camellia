# =====================================================================
# Camellia — environment configuration (copy to backend/.env and fill in)
#   cp .env.example backend/.env
# backend/.env is git-ignored. NEVER commit real values.
# =====================================================================

# ---- Google Gemini (required for AI features) ----
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Current stable Flash model at time of writing; change if your key needs another model.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=60

# ---- Snowflake (primary database; key-pair authentication) ----
# Account identifier in <orgname>-<account_name> form (Snowsight: Admin > Accounts)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
# Absolute path to your PKCS#8 private key, OUTSIDE the repo. Forward slashes work on Windows too.
#   Windows example: C:/Users/you/.snowflake/rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_FILE=
# Only if the private key is encrypted:
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_WAREHOUSE=CAMELLIA_WH
SNOWFLAKE_DATABASE=CAMELLIA_DEMO
SNOWFLAKE_SCHEMA=CLINICAL
SNOWFLAKE_ROLE=
# true = backend runs CREATE DATABASE/SCHEMA IF NOT EXISTS (needs privilege); false = they already exist
SNOWFLAKE_CREATE_DATABASE=true

# ---- Database mode ----
# auto      = Snowflake when SNOWFLAKE_ACCOUNT is set, otherwise the labeled LOCAL DEV FALLBACK (H2)
# snowflake = require Snowflake (fails fast with a diagnostic if config is incomplete)
# local     = local development fallback only (never presented as Snowflake)
CAMELLIA_DB_MODE=auto

# ---- Demo data ----
# Synthetic dates are relative to this anchor (blank = the day data is first seeded).
# Use "Reset demo data" in the System page to re-anchor to today.
CAMELLIA_DEMO_ANCHOR_DATE=
