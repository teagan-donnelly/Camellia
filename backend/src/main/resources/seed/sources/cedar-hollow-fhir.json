    { "resource": { "resourceType": "DocumentReference", "id": "doc-5503", "subject": { "reference": "Patient/CH-4012655" },
      "type": { "text": "Emergency department note" }, "date": "@D-210T23:55",
      "author": [{ "display": "Dr. Simone Achebe, MD" }],
      "context": { "encounter": [{ "reference": "Encounter/enc-5501" }], "practiceSetting": { "text": "Emergency Medicine" } },
      "content": [{ "attachment": { "contentType": "text/plain", "text": "Gradual-onset throbbing bifrontal headache for 10 hours with photophobia and nausea; similar but milder headaches over recent months. Neurologic exam normal. BP 142/90. CT head negative. Treated with IV fluids, metoclopramide and ketorolac with relief. Provisional diagnosis migraine without aura; sumatriptan prescribed; primary care follow-up advised." } }] } },
    { "resource": { "resourceType": "Condition", "id": "c-5504", "subject": { "reference": "Patient/CH-4012655" },
      "code": { "coding": [{ "system": "ICD-10-CM", "code": "G43.009", "display": "Migraine without aura (provisional)" }] },
      "clinicalStatus": { "coding": [{ "code": "active" }] }, "onsetDateTime": "@D-210",
      "recorder": { "display": "Dr. Simone Achebe, MD" }, "specialty": "Emergency Medicine" } },
    { "resource": { "resourceType": "MedicationStatement", "id": "med-5505", "subject": { "reference": "Patient/CH-4012655" },
      "medicationCodeableConcept": { "text": "Sumatriptan 50 mg tablet" }, "dosage": [{ "text": "50 mg at headache onset; may repeat once after 2 hours", "route": { "text": "Oral" } }],
      "status": "active", "effectivePeriod": { "start": "@D-210" }, "informationSource": { "display": "Dr. Simone Achebe, MD" } } },
    { "resource": { "resourceType": "Encounter", "id": "enc-6120", "subject": { "reference": "Patient/CH-4012655" },
