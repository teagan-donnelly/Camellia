    { "resource": { "resourceType": "Condition", "id": "c-7781", "subject": { "reference": "Patient/CH-4471002" },
      "code": { "coding": [{ "system": "ICD-10-CM", "code": "C81.10", "display": "Hodgkin lymphoma, nodular sclerosis (treated 2016; in remission)" }] },
      "clinicalStatus": { "coding": [{ "code": "remission" }] }, "onsetDateTime": "@D-3650",
      "recorder": { "display": "Dr. Naomi Feld, MD" }, "specialty": "Oncology" } },
    { "resource": { "resourceType": "Encounter", "id": "enc-6610", "subject": { "reference": "Patient/CH-4471002" },
      "class": { "code": "AMB" }, "type": [{ "text": "Oncology survivorship visit" }], "serviceType": { "text": "Oncology" },
      "period": { "start": "@D-420T09:00" }, "participant": [{ "individual": { "display": "Dr. Naomi Feld, MD" } }],
      "reasonCode": [{ "text": "Lymphoma survivorship surveillance" }], "department": "Oncology" } },
    { "resource": { "resourceType": "DocumentReference", "id": "doc-6611", "subject": { "reference": "Patient/CH-4471002" },
      "type": { "text": "Oncology survivorship note" }, "date": "@D-420T09:40",
      "author": [{ "display": "Dr. Naomi Feld, MD" }],
      "context": { "encounter": [{ "reference": "Encounter/enc-6610" }], "practiceSetting": { "text": "Oncology" } },
      "content": [{ "attachment": { "contentType": "text/plain", "text": "Hodgkin lymphoma, nodular sclerosis, stage IIA, diagnosed 2016. Completed 6 cycles of ABVD chemotherapy (cumulative doxorubicin 300 mg/m2) followed by mediastinal radiation 30 Gy. In continuous remission. Survivorship considerations: anthracycline and chest radiation exposure carry long-term cardiac risk; recommend cardiology evaluation, particularly before or during any future pregnancy. Patient reports planning pregnancy." } }] } },
