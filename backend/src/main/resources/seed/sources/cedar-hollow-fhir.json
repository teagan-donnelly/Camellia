      "reasonCode": [{ "text": "Headache with nausea, not relieved by home medication" }], "department": "Emergency Department" } },
    { "resource": { "resourceType": "DocumentReference", "id": "doc-6121", "subject": { "reference": "Patient/CH-4012655" },
      "type": { "text": "Emergency department note" }, "date": "@D-45T22:00",
      "author": [{ "display": "Dr. Victor Hale, MD" }],
      "context": { "encounter": [{ "reference": "Encounter/enc-6120" }], "practiceSetting": { "text": "Emergency Medicine" } },
      "content": [{ "attachment": { "contentType": "text/plain", "text": "Recurrent headache, third emergency or urgent care visit for headache in several months per patient. Reports ibuprofen 600 mg most days and sumatriptan twice weekly. BP 148/94. Normal neurologic examination. Treated with metoclopramide and IV fluids. Counseled on medication-overuse headache; strongly advised primary care and neurology follow-up." } }] } },

    { "resource": { "resourceType": "Encounter", "id": "enc-2201", "subject": { "reference": "Patient/CH-4120876" },
      "class": { "code": "IMP" }, "type": [{ "text": "Labor and delivery admission" }], "serviceType": { "text": "Obstetrics" },
      "period": { "start": "@D-1100T03:10" }, "participant": [{ "individual": { "display": "Dr. Marisol Okafor, MD" } }],
      "reasonCode": [{ "text": "Spontaneous labor at 39w1d" }], "department": "Labor & Delivery" } },
    { "resource": { "resourceType": "DocumentReference", "id": "doc-2202", "subject": { "reference": "Patient/CH-4120876" },
      "type": { "text": "Anesthesia record — labor analgesia and cesarean delivery" }, "date": "@D-1100T11:45",
      "author": [{ "display": "Dr. Kenji Watanabe, MD (Anesthesiology)" }],
      "context": { "encounter": [{ "reference": "Encounter/enc-2201" }], "practiceSetting": { "text": "Anesthesiology" } },
      "content": [{ "attachment": { "contentType": "text/plain", "text": "History of posterior spinal fusion T4-L2 for adolescent idiopathic scoliosis. Labor epidural attempted at L3-4 and L4-5 below the fusion: multiple passes required; catheter placed but inadequate, unilateral block; catheter replaced once with persistent inadequate analgesia (failed epidural). Category 2 tracing progressed to urgent cesarean delivery under general anesthesia. Airway: grade I view, uneventful intubation. Recommendation for future pregnancies: early obstetric anesthesia consultation with review of spine imaging before delivery." } }] } },
