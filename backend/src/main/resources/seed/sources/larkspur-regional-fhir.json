    { "resource": { "resourceType": "Encounter", "id": "E-91004", "subject": { "reference": "Patient/LR-288731" },
      "class": { "code": "AMB" }, "type": [{ "text": "Cardio-oncology consultation" }], "serviceType": { "text": "Cardiology" },
      "period": { "start": "@D-150T10:00" }, "participant": [{ "individual": { "display": "Dr. Rafael Chen, MD" } }],
      "reasonCode": [{ "text": "Pregnancy with prior anthracycline and chest radiation exposure" }], "department": "Cardiology Clinic" } },
    { "resource": { "resourceType": "DocumentReference", "id": "D-91005", "subject": { "reference": "Patient/LR-288731" },
      "type": { "text": "Cardio-oncology consult note" }, "date": "@D-150T11:10",
      "author": [{ "display": "Dr. Rafael Chen, MD" }],
      "context": { "encounter": [{ "reference": "Encounter/E-91004" }], "practiceSetting": { "text": "Cardiology" } },
      "content": [{ "attachment": { "contentType": "text/plain", "text": "36-year-old G1P0 at approximately 16 weeks gestation referred by maternal-fetal medicine. History of Hodgkin lymphoma (2016) treated with ABVD chemotherapy (cumulative doxorubicin exposure documented by oncology) and mediastinal radiation. Transthoracic echocardiogram today: LVEF 45% (mildly reduced), mild global hypokinesis, no significant valvular disease. Assessment: cardiomyopathy, likely anthracycline-associated, NYHA class I. Plan: repeat echocardiogram at approximately 32 weeks; cardiology to participate in multidisciplinary delivery planning with MFM and obstetric anesthesia; patient instructed to report dyspnea, orthopnea or edema." } }] } },
    { "resource": { "resourceType": "Condition", "id": "C-91006", "subject": { "reference": "Patient/LR-288731" },
      "code": { "coding": [{ "system": "ICD-10-CM", "code": "I42.7", "display": "Cardiomyopathy due to drug and external agent (anthracycline-associated), LVEF 45%" }] },
      "clinicalStatus": { "coding": [{ "code": "active" }] }, "onsetDateTime": "@D-150",
      "recorder": { "display": "Dr. Rafael Chen, MD" }, "specialty": "Cardiology" } },
    { "resource": { "resourceType": "DiagnosticReport", "id": "R-93310", "subject": { "reference": "Patient/LR-288731" },
      "category": { "text": "Imaging" }, "code": { "text": "Transthoracic echocardiogram (follow-up, ~32 weeks)" },
      "effectiveDateTime": "@D-30T09:15", "performer": [{ "display": "Dr. Rafael Chen, MD" }], "specialty": "Cardiology",
      "conclusion": "LVEF 43-45%, unchanged from prior study. Mild global hypokinesis. No pericardial effusion. Findings communicated to MFM (Dr. Lena Abernathy)." } },
