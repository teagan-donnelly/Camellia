      "context": { "encounter": [{ "reference": "Encounter/E-50120" }], "practiceSetting": { "text": "Endocrinology" } },
      "content": [{ "attachment": { "contentType": "text/plain", "text": "Type 2 diabetes since 2012 on metformin; A1c 6.6%. Hypothyroidism stable on levothyroxine 75 mcg, TSH within range. CKD stage 2 (eGFR 72), stable. Obstructive sleep apnea, using CPAP nightly. Hyperlipidemia on atorvastatin. Past surgical history: laparoscopic cholecystectomy (2010) under general anesthesia, uneventful; screening colonoscopy with monitored anesthesia care, uneventful. Continue current regimen; return in 6 months." } }] } },
