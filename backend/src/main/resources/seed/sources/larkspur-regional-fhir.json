      "context": { "encounter": [{ "reference": "Encounter/E-70551" }], "practiceSetting": { "text": "Orthopedics" } },
      "content": [{ "attachment": { "contentType": "text/plain", "text": "Three weeks of right forefoot pain without trauma; walks about 2 miles daily. Radiographs: healing stress fracture of the right third metatarsal shaft. Patient mentions a prior wrist fracture treated at an urgent care clinic and rib fractures treated at Cedar Hollow. Long-term inhaled corticosteroid use for COPD with several oral prednisone courses. Plan: walking boot for 6 weeks; check vitamin D; outpatient bone density (DXA) evaluation recommended to primary care." } }] } },
