    { "resource": { "resourceType": "DocumentReference", "id": "D-88121", "subject": { "reference": "Patient/LR-301144" },
      "type": { "text": "Anesthesia procedure note — labor epidural" }, "date": "@D-1310T06:05",
      "author": [{ "display": "Marcus Bell, CRNA" }],
      "context": { "encounter": [{ "reference": "Encounter/E-88120" }], "practiceSetting": { "text": "Anesthesiology" } },
      "content": [{ "attachment": { "contentType": "text/plain", "text": "Labor epidural placed at L3-4 on first attempt, loss of resistance to saline at 5 cm. Test dose negative. Good bilateral sensory block. Admission platelet count 221 x10^3/uL. No complications. Uncomplicated spontaneous vaginal delivery. Anesthesia history otherwise unremarkable; no personal or family history of anesthesia complications reported." } }] } },
